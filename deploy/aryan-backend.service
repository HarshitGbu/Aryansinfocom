[Unit]
Description=Aryans Infocom backend (FastAPI)
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/aryan-infocom/Backend
EnvironmentFile=/opt/aryan-infocom/.env
Environment=DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/agency
Environment=REDIS_URL=redis://localhost:6379/0
Environment=CORS_ORIGINS=http://localhost
Environment=ENVIRONMENT=production
ExecStart=/opt/aryan-infocom/Backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target