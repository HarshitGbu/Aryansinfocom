  "components": {
    "schemas": {
      "ContactRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "company": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ],
            "title": "Company"
          },
          "topic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Topic"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Message"
          },
          "consent": {
            "type": "boolean",
            "title": "Consent"
          },
          "website": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Website"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "email",
          "message",
          "consent"
        ],
        "title": "ContactRequest"
      },
      "EstimateRequest": {
        "properties": {
          "selected_services": {
            "items": {
              "type": "string",
              "enum": [
                "custom_web",
                "erp_custom",
                "ai_solutions",
                "office_networking",
                "local_ai_server",
                "workstation_provisioning"
              ]
            },
            "type": "array",
            "maxItems": 6,
            "minItems": 1,
            "title": "Selected Services"
          },
          "office_parameters": {
            "$ref": "#/components/schemas/OfficeParameters"
          },
          "software_parameters": {
            "$ref": "#/components/schemas/SoftwareParameters"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "selected_services"
        ],
        "title": "EstimateRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LeadSubmitRequest": {
        "properties": {
          "client_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Client Name"
          },
          "client_email": {
            "type": "string",
            "format": "email",
            "title": "Client Email"
          },
          "company_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ],
            "title": "Company Name"
          },
          "phone_number": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone Number"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "estimate_input": {
            "$ref": "#/components/schemas/EstimateRequest"
          },
          "consent": {
            "type": "boolean",
            "title": "Consent"
          },
          "website": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Website"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_name",
          "client_email",
          "estimate_input",
          "consent"
        ],
        "title": "LeadSubmitRequest"
      },
      "OfficeParameters": {
        "properties": {
          "workstations": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 0.0,
            "title": "Workstations",
            "default": 0
          },
          "floor_area_sqft": {
            "type": "integer",
            "maximum": 200000.0,
            "minimum": 0.0,
            "title": "Floor Area Sqft",
            "default": 0
          },
          "require_server_rack": {
            "type": "boolean",
            "title": "Require Server Rack",
            "default": false
          },
          "air_gapped_security": {
            "type": "boolean",
            "title": "Air Gapped Security",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "OfficeParameters"
      },
      "PromptParseRequest": {
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 500,
            "minLength": 3,
            "title": "Prompt"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "PromptParseRequest"
      },
      "RagRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Query"
          },
          "top_k": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 2
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query"
        ],
        "title": "RagRequest"
      },
      "SoftwareParameters": {
        "properties": {
          "user_roles_count": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 0.0,
            "title": "User Roles Count",
            "default": 0
          },
          "third_party_integrations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Third Party Integrations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SoftwareParameters"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}